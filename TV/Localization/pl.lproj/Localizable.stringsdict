			<key>few</key>
			<string>za %ld dni</string>
			<key>many</key>
			<string>za %ld dni</string>
			<key>other</key>
			<string>za %ld dnia</string>
		</dict>
	</dict>
	<key>in %ld weeks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
