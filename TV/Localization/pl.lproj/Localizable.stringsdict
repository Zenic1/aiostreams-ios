<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%ld seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld sekunda</string>
			<key>few</key>
			<string>%ld sekundy</string>
			<key>many</key>
			<string>%ld sekund</string>
			<key>other</key>
			<string>%ld sekundy</string>
		</dict>
	</dict>
	<key>%ld seconds before the end</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld sekundę przed końcem</string>
			<key>few</key>
			<string>%ld sekundy przed końcem</string>
			<key>many</key>
			<string>%ld sekund przed końcem</string>
			<key>other</key>
			<string>%ld sekundy przed końcem</string>
		</dict>
	</dict>
	<key>%ld titles</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld tytuł</string>
			<key>few</key>
			<string>%ld tytuły</string>
			<key>many</key>
			<string>%ld tytułów</string>
			<key>other</key>
			<string>%ld tytułu</string>
		</dict>
	</dict>
	<key>%ld versions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld wersja</string>
			<key>few</key>
			<string>%ld wersje</string>
			<key>many</key>
			<string>%ld wersji</string>
			<key>other</key>
			<string>%ld wersji</string>
		</dict>
	</dict>
	<key>After %ld episodes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Po %ld odcinku</string>
			<key>other</key>
			<string>Po %ld odcinkach</string>
		</dict>
	</dict>
	<key>in %ld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
