+/**
+ * When the page was last hidden. On iOS the app leaving the screen suspends the page, which cuts
+ * off a version search under way; one cut off that way waits for the page to show again and is
+ * tried again then, rather than failing with "Can't reach the server".
+ */
+let lastHidden =
+  typeof document !== 'undefined' && document.visibilityState === 'hidden'
+    ? Date.now()
+    : 0;
+if (typeof document !== 'undefined')
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'hidden') lastHidden = Date.now();
+  });
+
+function untilVisible(): Promise<void> {
+  return new Promise((resolve) => {
+    if (document.visibilityState === 'visible') return resolve();
+    const shown = () => {
+      if (document.visibilityState !== 'visible') return;
+      document.removeEventListener('visibilitychange', shown);
+      resolve();
+    };
+    document.addEventListener('visibilitychange', shown);
+  });
+}
