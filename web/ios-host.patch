diff --git a/packages/web/src/lib/hosts/shell/ios.ts b/packages/web/src/lib/hosts/shell/ios.ts
new file mode 100644
index 00000000..d54fa59b
--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/ios.ts
@@ -0,0 +1,48 @@
+import type { Host } from '..';
+import { appBridge, ask } from './bridge';
+import { appEngine } from './player';
+import { resolveYouTube } from './youtube';
+import { shellDownloads } from './downloads';
+
+let fullscreen = false;
+
+/** Follows the iOS app's full screen, which hides the status bar and turns to landscape. */
+export function setupIos(): () => void {
+  const unsubscribe = appBridge()?.subscribe((m) => {
+    if (m.type === 'fullscreen') fullscreen = m.value;
+  });
+  return () => unsubscribe?.();
+}
+
+/** The iOS app: the page over AetherEngine, which draws the video beneath it. */
+export const iosHost: Host = {
+  name: 'ios-app',
+  device: () => ({ id: appBridge()?.deviceId, name: appBridge()?.device }),
+  player: appEngine,
+  // The stats overlay is the app's own, drawn over the video (player-stats-overlay).
+  playerFeatures: ['audio', 'chapters', 'headers', 'upscaling', 'stats'],
+  resolveYouTube,
+  // The app's queue, which keeps going in the background and while the page reloads.
+  downloads: shellDownloads,
+  // A tab of its own for the app's diagnostics, which Open shares from the system's share sheet.
+  settings: {
+    label: 'iOS app',
+    description: 'Diagnostics for a problem report',
+    help: "Shares the app's log and device details, for a problem report.",
+    open: () => appBridge()?.send({ type: 'share-diagnostics' }),
+  },
+  fullscreen: {
+    active: () => fullscreen,
+    set: (on) => appBridge()?.send({ type: 'fullscreen', value: on }),
+  },
+  saveFile: (name, type, text) =>
+    appBridge()?.send({ type: 'save-file', name, mime: type, text }),
+  // Swipes up and down on the video set the volume and the screen's brightness, as on Android.
+  levels: {
+    read: () => ask({ type: 'levels' }, 'levels'),
+    set: (level, value) =>
+      appBridge()?.send({ type: 'set-level', level, value }),
+    release: () =>
+      appBridge()?.send({ type: 'set-level', level: 'brightness', value: null }),
+  },
+};
